        <div class="fw"><div class="fb" style="width:2.00%;background:#1D9E75">0.5% · 19</div></div>
      </div>
      <div class="funnel-row">
        <div class="fl">Reuniões realizadas</div>
        <div class="fw"><div class="fb" style="width:2.00%;background:#0F6E56">0.4% · 17</div></div>
      </div>
    </div>

  </div>
</div>

<script>
const SECTOR_DATA = {"tec": {"months": ["jan/23", "fev/23", "mar/23", "abr/23", "mai/23", "jun/23", "jul/23", "ago/23", "set/23", "out/23", "nov/23", "dez/23", "jan/24", "fev/24", "mar/24", "abr/24", "mai/24", "jun/24", "jul/24", "ago/24", "set/24", "out/24", "nov/24", "dez/24", "jan/25", "fev/25", "mar/25", "abr/25", "mai/25", "jun/25", "jul/25", "ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26", "jun/26", "jul/26"], "esforco": [201, 480, 1167, 741, 654, 403, 523, 458, 447, 219, 338, 677, 1639, 1654, 1070, 1190, 1090, 1569, 1489, 1643, 1945, 2008, 1399, 1476, 1374, 1632, 1822, 1827, 1236, 1800, 3006, 2954, 2196, 3036, 2030, 1947, 2515, 2240, 3051, 2615, 2334, 2775, 2185], "realizados": [2, 0, 8, 11, 8, 5, 3, 5, 4, 7, 5, 3, 7, 10, 10, 12, 3, 14, 10, 13, 17, 7, 4, 6, 11, 7, 11, 13, 17, 18, 31, 20, 22, 32, 25, 17, 31, 28, 17, 20, 21, 18, 31], "accent": "#00B8AD"}, "log": {"months": ["ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26", "jun/26", "jul/26"], "esforco": [7, 600, 449, 310, 278, 1217, 1080, 1028, 1056, 1000, 1308, 608], "realizados": [0, 2, 7, 7, 3, 12, 20, 19, 24, 23, 21, 7], "accent": "#378ADD"}, "edu": {"months": ["out/24", "nov/24", "dez/24", "jan/25", "fev/25", "mar/25", "abr/25", "mai/25", "jun/25", "jul/25", "ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26", "jun/26", "jul/26"], "esforco": [793, 550, 321, 514, 489, 433, 368, 463, 696, 607, 404, 402, 400, 316, 162, 400, 363, 205, 230, 380, 200, 204], "realizados": [0, 3, 2, 3, 4, 1, 2, 5, 2, 4, 2, 4, 3, 3, 3, 4, 5, 3, 2, 3, 2, 5], "accent": "#EF9F27"}, "agro": {"months": ["mai/25", "jun/25", "jul/25", "ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26", "jun/26", "jul/26"], "esforco": [385, 334, 314, 1181, 349, 726, 523, 405, 351, 540, 1344, 613, 393, 455, 545], "realizados": [4, 4, 2, 3, 6, 4, 6, 3, 5, 3, 0, 1, 4, 0, 1], "accent": "#7F77DD"}, "tur": {"months": ["mai/23", "jun/23", "jul/23", "ago/23", "set/23", "out/23", "nov/23", "dez/23", "jan/24", "fev/24", "mar/24", "abr/24", "mai/24", "jun/24", "jul/24", "mai/26"], "esforco": [263, 483, 468, 522, 462, 653, 261, 267, 445, 294, 512, 396, 449, 5, 4, 1], "realizados": [0, 6, 7, 9, 3, 2, 8, 4, 2, 8, 3, 8, 4, 1, 0, 0], "accent": "#D85A30"}, "hig": {"months": ["mar/25", "abr/25", "mai/25", "jun/25", "jul/25", "ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26", "jun/26"], "esforco": [152, 405, 389, 334, 343, 764, 424, 460, 349, 172, 398, 307, 293, 229, 167, 2], "realizados": [0, 1, 6, 6, 0, 6, 8, 8, 8, 5, 5, 7, 8, 5, 3, 0], "accent": "#00B8AD"}, "cons": {"months": ["abr/25", "mai/25", "jun/25", "jul/25", "ago/25", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26"], "esforco": [484, 304, 439, 324, 456, 442, 792, 270, 177, 548, 350, 12], "realizados": [1, 3, 5, 0, 3, 1, 5, 3, 2, 4, 4, 0], "accent": "#378ADD"}, "ene": {"months": ["set/24", "set/25", "out/25", "nov/25", "dez/25", "jan/26", "fev/26", "mar/26", "abr/26", "mai/26"], "esforco": [9, 441, 601, 649, 338, 541, 433, 408, 519, 135], "realizados": [2, 0, 0, 2, 1, 3, 2, 3, 1, 3], "accent": "#EF9F27"}};

function sw(id, btn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  btn.classList.add('active');
  setTimeout(() => ensureChart(id), 50);
}

const gc = 'rgba(255,255,255,0.06)';
const lc = '#6B7877';
const chartInstances = {};
const chartState = {};

function filterByPeriod(arr, months, periodVal) {
  if (periodVal === 'all') return arr;
  const n = parseInt(periodVal, 10);
  return arr.slice(-n);
}

function buildChart(slug) {
  const d = SECTOR_DATA[slug];
  const state = chartState[slug] || { metric: 'combined', period: 'all' };
  chartState[slug] = state;

  const months = filterByPeriod(d.months, d.months, state.period);
  const legEl = document.getElementById('leg-' + slug);

  if (chartInstances[slug]) {
    chartInstances[slug].destroy();
  }

  const nMonths = months.length;

  if (state.metric === 'combined') {
    const esforco = filterByPeriod(d.esforco, d.months, state.period);
    const realizados = filterByPeriod(d.realizados, d.months, state.period);
    if (legEl) {
      legEl.innerHTML = '<span><span class="ldot" style="background:' + d.accent + '"></span>Esforço (atividades)</span>' +
        '<span><span class="ldot" style="background:#1D9E75"></span>Reuniões realizadas (eixo direito)</span>';
    }
    chartInstances[slug] = new Chart(document.getElementById('c-' + slug), {
      type: 'bar',
      data: {
        labels: months,
        datasets: [
          { label: 'Esforço', data: esforco, backgroundColor: d.accent + 'CC', borderRadius: 3, order: 2 },
          { label: 'Reuniões realizadas', data: realizados, type: 'line', borderColor: '#1D9E75', backgroundColor: 'rgba(29,158,117,0.08)', pointBackgroundColor: '#1D9E75', pointRadius: 3, fill: true, tension: 0.3, yAxisID: 'y2', order: 1 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: lc, font: { size: 9, family: "'DM Mono'" }, maxRotation: 45, autoSkip: nMonths > 18 }, grid: { display: false } },
          y: { ticks: { color: lc, font: { size: 10 } }, grid: { color: gc } },
          y2: { position: 'right', ticks: { color: '#1D9E75', font: { size: 10 } }, grid: { display: false } }
        }
      }
    });
    return;
  }

  const isEsforco = state.metric === 'esforco';
  const values = isEsforco ? filterByPeriod(d.esforco, d.months, state.period) : filterByPeriod(d.realizados, d.months, state.period);
  const color = isEsforco ? d.accent : '#1D9E75';
  const label = isEsforco ? 'Esforço (atividades)' : 'Reuniões realizadas';

  if (legEl) {
    legEl.innerHTML = '<span><span class="ldot" style="background:' + color + '"></span>' + label + '</span>';
  }

  const dataset = isEsforco
    ? { label: label, data: values, backgroundColor: color + 'CC', borderRadius: 3, type: 'bar' }
    : { label: label, data: values, type: 'line', borderColor: '#1D9E75', backgroundColor: 'rgba(29,158,117,0.08)', pointBackgroundColor: '#1D9E75', pointRadius: 3, fill: true, tension: 0.3 };

  chartInstances[slug] = new Chart(document.getElementById('c-' + slug), {
    type: isEsforco ? 'bar' : 'line',
    data: {
      labels: months,
      datasets: [dataset]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: lc, font: { size: 9, family: "'DM Mono'" }, maxRotation: 45, autoSkip: nMonths > 18 }, grid: { display: false } },
        y: { ticks: { color: lc, font: { size: 10 } }, grid: { color: gc } }
      }
    }
  });
}

function ensureChart(slug) {
  if (chartInstances[slug]) return;
  buildChart(slug);
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.chart-controls').forEach(ctrl => {
    const slug = ctrl.getAttribute('data-slug');
    chartState[slug] = { metric: 'combined', period: 'all' };

    ctrl.querySelectorAll('.seg-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        ctrl.querySelectorAll('.seg-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        chartState[slug].metric = btn.getAttribute('data-metric');
        buildChart(slug);
      });
    });

    const sel = ctrl.querySelector('.period-select');
    sel.addEventListener('change', () => {
      chartState[slug].period = sel.value;
      buildChart(slug);
    });
  });

  ensureChart('tec');
});
</script>
