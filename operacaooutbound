<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grupo Escalar — Operação Outbound por Setor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root {
  --bg: #0E1417;
  --surface: #161D20;
  --surface2: #1F2A2E;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.14);
  --text: #EEF2F1;
  --text-muted: #93A2A2;
  --text-dim: #4E5A5A;
  --brand: #00B8AD;
  --brand-light: #3DD9CC;
  --brand-dim: rgba(0,184,173,0.12);
  --blue: #378ADD;
  --blue-light: #85B7EB;
  --blue-dim: rgba(55,138,221,0.12);
  --teal: #1D9E75;
  --teal-light: #5DCAA5;
  --teal-dim: rgba(29,158,117,0.12);
  --amber: #EF9F27;
  --amber-dim: rgba(239,159,39,0.12);
  --purple: #7F77DD;
  --purple-dim: rgba(127,119,221,0.12);
  --coral: #D85A30;
  --font-display: 'Poppins', sans-serif;
  --font-body: 'Poppins', sans-serif;
  --font-mono: 'DM Mono', monospace;
  --r: 10px;
  --r-lg: 16px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.6;
  min-height: 100vh;
}
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
header {
  border-bottom: 0.5px solid var(--border);
  padding: 22px 0;
  position: sticky;
  top: 0;
  background: rgba(14,20,23,0.92);
  backdrop-filter: blur(12px);
  z-index: 100;
}
.header-inner { display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 14px; }
.brand img.logo { height: 30px; width: auto; display: block; }
.header-badge {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--brand-light);
  background: var(--brand-dim);
  border: 0.5px solid rgba(0,184,173,0.25);
  padding: 5px 12px;
  border-radius: 20px;
  letter-spacing: 0.03em;
  white-space: nowrap;
}
.tabs-wrap {
  border-bottom: 0.5px solid var(--border);
  margin-top: 0;
  background: var(--bg);
  position: sticky;
  top: 79px;
  z-index: 99;
}
.tabs {
  display: flex;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  padding: 16px 22px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  font-family: var(--font-body);
  letter-spacing: 0.01em;
}
.tab:hover { color: var(--text); }
.tab.active { color: var(--text); border-bottom-color: var(--brand); }
.page { display: none; padding: 48px 0 80px; }
.page.active { display: block; }
.hero { margin-bottom: 56px; }
.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--brand-light);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.hero-eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--brand); }
.hero-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 8px;
}
.hero h2 {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 700;
  color: var(--text);
  line-height: 1.15;
  margin-bottom: 16px;
}
.hero p { font-size: 16px; color: var(--text-muted); max-width: 580px; line-height: 1.7; }
.slbl {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 16px;
  margin-top: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.slbl::after { content: ''; flex: 1; height: 0.5px; background: var(--border); }
.slbl-first { margin-top: 0; }
.grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; }
.mc {
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--r);
  padding: 20px 22px;
  transition: border-color 0.2s;
}
.mc:hover { border-color: var(--border2); }
.mc .lbl { font-size: 11px; color: var(--text-muted); margin-bottom: 10px; letter-spacing: 0.02em; }
.mc .val {
  font-family: var(--font-display);
  font-size: 34px;
  font-weight: 600;
  color: var(--text);
  line-height: 1;
}
.mc .sub { font-size: 11px; color: var(--text-dim); margin-top: 8px; }
.mc .sub.g { color: var(--brand-light); }
.mc .sub.b { color: var(--brand-light); }
.mc-accent { border-color: rgba(0,184,173,0.28); background: linear-gradient(135deg, var(--surface) 0%, rgba(0,184,173,0.07) 100%); }
hr { border: none; border-top: 0.5px solid var(--border); margin: 40px 0; }
.funnel-row { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
.fl { font-size: 13px; color: var(--text-muted); width: 240px; flex-shrink: 0; }
.fw { flex: 1; background: var(--surface2); border-radius: 5px; height: 30px; overflow: hidden; border: 0.5px solid var(--border); }
.fb {
  height: 100%;
  border-radius: 5px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  font-size: 11px;
  font-family: var(--font-mono);
  color: #fff;
  font-weight: 500;
  transition: width 0.8s cubic-bezier(.23,1,.32,1);
}
.chart-box { position: relative; width: 100%; }
.leg { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 12px; font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); }
.leg span { display: flex; align-items: center; gap: 6px; }
.ldot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

/* CHART CONTROLS */
.chart-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 14px;
}
.seg-toggle {
  display: inline-flex;
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: 8px;
  padding: 3px;
  gap: 2px;
}
.seg-btn {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 7px 14px;
  cursor: pointer;
  transition: all 0.15s;
  white-space: nowrap;
}
.seg-btn:hover { color: var(--text); }
.seg-btn.active { background: var(--brand); color: #07100F; font-weight: 600; }
.period-select {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--text);
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  cursor: pointer;
  outline: none;
}
.period-select:hover { border-color: var(--border2); }
@media (max-width: 800px) {
  .grid-4 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .container { padding: 0 18px; }
}
</style>
</head>
